# Example environment file for Supabase Functions.
# Copy this to .env and fill in real values before running `supabase start` or `supabase functions serve`.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_anon_yourkey
SUPABASE_SERVICE_ROLE_KEY=sb_service_role_yourkey
INVITE_BASE_URL=https://your-app.example.com
